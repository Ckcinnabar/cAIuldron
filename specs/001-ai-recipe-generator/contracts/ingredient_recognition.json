{
  "contract_name": "Ingredient Recognition API",
  "description": "CNN-based ingredient identification and size estimation from uploaded photos",
  "version": "1.0.0",
  "model_component": "CNN (EfficientNetV2-S)",

  "input_schema": {
    "type": "object",
    "required": ["image_data"],
    "properties": {
      "image_data": {
        "type": "object",
        "description": "Uploaded ingredient photo",
        "properties": {
          "image_bytes": {
            "type": "string",
            "format": "base64",
            "description": "Base64-encoded image data"
          },
          "format": {
            "type": "string",
            "enum": ["JPEG", "PNG", "HEIC"],
            "description": "Image format"
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {"type": "integer", "minimum": 100, "maximum": 4096},
              "height": {"type": "integer", "minimum": 100, "maximum": 4096}
            }
          }
        }
      },
      "preprocessing_options": {
        "type": "object",
        "description": "Optional preprocessing parameters",
        "properties": {
          "resize_to": {
            "type": "integer",
            "default": 384,
            "description": "Target size for model input (EfficientNetV2 optimal: 384)"
          },
          "enhance_contrast": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["ingredient", "confidence_score", "estimated_quantity"],
    "properties": {
      "ingredient": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for this ingredient detection"
          },
          "name": {
            "type": "string",
            "description": "Identified ingredient name",
            "examples": ["chicken breast", "salmon fillet", "broccoli"]
          },
          "category": {
            "type": "string",
            "enum": ["protein", "vegetable", "fruit", "grain", "dairy", "other"],
            "description": "Food category"
          },
          "alternative_names": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Other possible names for this ingredient"
          }
        }
      },
      "confidence_score": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Model confidence in identification (0.7+ for automatic processing)"
      },
      "top_predictions": {
        "type": "array",
        "description": "Top 5 ingredient predictions with scores",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "score": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        },
        "maxItems": 5
      },
      "visual_characteristics": {
        "type": "object",
        "properties": {
          "dominant_color": {
            "type": "string",
            "description": "Primary color detected"
          },
          "texture": {
            "type": "string",
            "description": "Surface texture description"
          },
          "shape": {
            "type": "string",
            "description": "Basic shape category"
          }
        }
      },
      "estimated_quantity": {
        "type": "object",
        "description": "Size estimation based on visual analysis",
        "properties": {
          "weight_grams": {
            "type": "number",
            "minimum": 0,
            "description": "Estimated weight in grams"
          },
          "weight_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence in weight estimate"
          },
          "volume_ml": {
            "type": "number",
            "minimum": 0,
            "description": "Estimated volume in milliliters (if applicable)"
          },
          "unit_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of items if countable"
          },
          "reference_detected": {
            "type": "boolean",
            "description": "Whether size reference object was found in image"
          }
        },
        "required": ["weight_grams", "weight_confidence", "reference_detected"]
      },
      "processing_metadata": {
        "type": "object",
        "properties": {
          "model_version": {"type": "string"},
          "inference_time_ms": {"type": "number"},
          "preprocessing_applied": {"type": "array", "items": {"type": "string"}},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    }
  },

  "error_responses": [
    {
      "error_code": "INVALID_IMAGE_FORMAT",
      "description": "Image format not supported or corrupted",
      "http_status": 400
    },
    {
      "error_code": "LOW_CONFIDENCE",
      "description": "Cannot confidently identify ingredient (score < 0.7)",
      "http_status": 200,
      "response": {
        "confidence_score": "< 0.7",
        "action_required": "USER_CONFIRMATION",
        "message": "Please confirm the ingredient or upload a clearer photo"
      }
    },
    {
      "error_code": "NO_INGREDIENT_DETECTED",
      "description": "No food ingredient found in image",
      "http_status": 400
    },
    {
      "error_code": "MODEL_INFERENCE_ERROR",
      "description": "CNN model inference failed",
      "http_status": 500
    }
  ],

  "performance_requirements": {
    "max_inference_time_ms": 100,
    "max_memory_mb": 500,
    "accuracy_target": "90% top-1 on common ingredients",
    "confidence_threshold": 0.7
  },

  "notebook_implementation": {
    "location": "notebooks/model_ingredient_recognition/model_cnn_inference.ipynb",
    "input_cell": "Process uploaded image through EfficientNetV2",
    "output_cell": "Return ingredient prediction with confidence and size estimate"
  }
}
