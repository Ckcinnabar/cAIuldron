{
  "contract_name": "Ingredient Recognition API",
  "description": "Roboflow-based ingredient identification and size estimation from uploaded photos using object detection",
  "version": "2.0.0",
  "model_component": "Roboflow food-ingredients-dataset v2 (Object Detection via Inference SDK)",
  "deployment_mode": "serverless",

  "input_schema": {
    "type": "object",
    "required": ["image_data"],
    "properties": {
      "image_data": {
        "type": "object",
        "description": "Uploaded ingredient photo",
        "properties": {
          "image_bytes": {
            "type": "string",
            "format": "base64",
            "description": "Base64-encoded image data"
          },
          "format": {
            "type": "string",
            "enum": ["JPEG", "PNG", "HEIC", "WebP"],
            "description": "Image format (Roboflow supports JPEG, PNG, WebP, HEIC)"
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {"type": "integer", "minimum": 100, "maximum": 4096},
              "height": {"type": "integer", "minimum": 100, "maximum": 4096}
            }
          }
        }
      },
      "detection_options": {
        "type": "object",
        "description": "Optional detection parameters for Roboflow API",
        "properties": {
          "confidence_threshold": {
            "type": "number",
            "default": 0.7,
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Minimum confidence score for detections"
          },
          "overlap_threshold": {
            "type": "number",
            "default": 0.3,
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "IOU threshold for non-maximum suppression"
          }
        }
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["ingredient", "confidence_score", "estimated_quantity"],
    "properties": {
      "ingredient": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for this ingredient detection"
          },
          "name": {
            "type": "string",
            "description": "Identified ingredient name",
            "examples": ["chicken breast", "salmon fillet", "broccoli"]
          },
          "category": {
            "type": "string",
            "enum": ["protein", "vegetable", "fruit", "grain", "dairy", "other"],
            "description": "Food category"
          },
          "alternative_names": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Other possible names for this ingredient"
          }
        }
      },
      "confidence_score": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Model confidence in identification (0.7+ for automatic processing)"
      },
      "top_predictions": {
        "type": "array",
        "description": "Top 5 ingredient predictions with scores",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "score": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        },
        "maxItems": 5
      },
      "visual_characteristics": {
        "type": "object",
        "properties": {
          "bounding_box": {
            "type": "object",
            "description": "Detection bounding box coordinates",
            "properties": {
              "x": {"type": "number", "description": "Center X coordinate"},
              "y": {"type": "number", "description": "Center Y coordinate"},
              "width": {"type": "number", "description": "Box width"},
              "height": {"type": "number", "description": "Box height"}
            },
            "required": ["x", "y", "width", "height"]
          },
          "detection_class": {
            "type": "string",
            "description": "Raw class name from Roboflow model"
          },
          "area_ratio": {
            "type": "number",
            "description": "Ratio of bounding box area to image area"
          }
        }
      },
      "estimated_quantity": {
        "type": "object",
        "description": "Size estimation based on visual analysis",
        "properties": {
          "weight_grams": {
            "type": "number",
            "minimum": 0,
            "description": "Estimated weight in grams"
          },
          "weight_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence in weight estimate"
          },
          "volume_ml": {
            "type": "number",
            "minimum": 0,
            "description": "Estimated volume in milliliters (if applicable)"
          },
          "unit_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of items if countable"
          },
          "reference_detected": {
            "type": "boolean",
            "description": "Whether size reference object was found in image"
          }
        },
        "required": ["weight_grams", "weight_confidence", "reference_detected"]
      },
      "processing_metadata": {
        "type": "object",
        "properties": {
          "model_version": {"type": "string"},
          "inference_time_ms": {"type": "number"},
          "preprocessing_applied": {"type": "array", "items": {"type": "string"}},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    }
  },

  "error_responses": [
    {
      "error_code": "INVALID_IMAGE_FORMAT",
      "description": "Image format not supported or corrupted",
      "http_status": 400
    },
    {
      "error_code": "LOW_CONFIDENCE",
      "description": "Cannot confidently identify ingredient (score < 0.7)",
      "http_status": 200,
      "response": {
        "confidence_score": "< 0.7",
        "action_required": "USER_CONFIRMATION",
        "message": "Please confirm the ingredient or upload a clearer photo"
      }
    },
    {
      "error_code": "NO_INGREDIENT_DETECTED",
      "description": "No food ingredient found in image",
      "http_status": 400
    },
    {
      "error_code": "MODEL_INFERENCE_ERROR",
      "description": "Roboflow API inference failed",
      "http_status": 500
    },
    {
      "error_code": "API_CONNECTION_ERROR",
      "description": "Unable to connect to Roboflow serverless API",
      "http_status": 503
    }
  ],

  "performance_requirements": {
    "max_inference_time_ms": 500,
    "max_memory_mb": 200,
    "accuracy_target": "Roboflow pre-trained model (version 2)",
    "confidence_threshold": 0.7,
    "note": "Serverless deployment - no local model loading overhead"
  },

  "notebook_implementation": {
    "setup_notebook": "notebooks/model_ingredient_recognition/setup_roboflow_model.ipynb",
    "inference_notebook": "notebooks/model_ingredient_recognition/model_cnn_inference.ipynb",
    "adapter_notebook": "notebooks/model_ingredient_recognition/adapter_to_recipe_generation.ipynb",
    "input_cell": "Process uploaded image through Roboflow Inference SDK",
    "output_cell": "Return ingredient entity with bounding box, confidence, and size estimate",
    "api_used": "Roboflow Inference SDK (inference-sdk package)",
    "model_id": "food-ingredients-dataset/2"
  }
}
