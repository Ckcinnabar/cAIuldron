{
  "contract_name": "Illustration Generation API",
  "description": "GAN-based line-art illustration generation for cooking steps",
  "version": "1.0.0",
  "model_component": "Pix2Pix GAN (U-Net + PatchGAN)",

  "input_schema": {
    "type": "object",
    "required": ["cooking_step"],
    "properties": {
      "cooking_step": {
        "type": "object",
        "description": "Step to illustrate",
        "properties": {
          "step_id": {"type": "string", "format": "uuid"},
          "step_number": {"type": "integer"},
          "instruction_text": {"type": "string"},
          "cooking_method": {
            "type": "string",
            "enum": ["chop", "dice", "slice", "sauté", "fry", "bake", "roast", "boil", "simmer", "grill", "steam", "mix", "marinate", "rest", "serve"]
          },
          "ingredients_involved": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Ingredients used in this step"
          }
        },
        "required": ["step_id", "instruction_text", "cooking_method"]
      },
      "style_preferences": {
        "type": "object",
        "description": "Illustration style parameters",
        "properties": {
          "complexity": {
            "type": "string",
            "enum": ["simple", "moderate", "detailed"],
            "default": "moderate",
            "description": "Level of detail in illustration"
          },
          "line_weight": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 5.0,
            "default": 2.0,
            "description": "Stroke thickness in pixels"
          },
          "output_format": {
            "type": "string",
            "enum": ["SVG", "PNG"],
            "default": "SVG",
            "description": "Image format (SVG for scalability)"
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {"type": "integer", "default": 512},
              "height": {"type": "integer", "default": 512}
            }
          }
        }
      },
      "generation_params": {
        "type": "object",
        "properties": {
          "seed": {
            "type": "integer",
            "description": "Random seed for reproducible generation"
          },
          "use_template": {
            "type": "boolean",
            "default": true,
            "description": "Use template illustrations for common actions"
          },
          "enhance_edges": {
            "type": "boolean",
            "default": true,
            "description": "Apply edge enhancement post-processing"
          }
        }
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["illustration"],
    "properties": {
      "illustration": {
        "type": "object",
        "required": ["illustration_id", "image_data", "alt_text"],
        "properties": {
          "illustration_id": {
            "type": "string",
            "format": "uuid"
          },
          "image_data": {
            "type": "object",
            "required": ["format", "file_path", "width_px", "height_px"],
            "properties": {
              "format": {
                "type": "string",
                "enum": ["SVG", "PNG"]
              },
              "file_path": {
                "type": "string",
                "description": "Path where illustration is saved",
                "pattern": "^data/results/illustrations/.*\\.(svg|png)$"
              },
              "base64_data": {
                "type": "string",
                "description": "Optional: base64-encoded image for inline display"
              },
              "width_px": {"type": "integer"},
              "height_px": {"type": "integer"}
            }
          },
          "style_metadata": {
            "type": "object",
            "properties": {
              "line_weight": {"type": "number"},
              "color_scheme": {
                "type": "string",
                "default": "monochrome",
                "description": "Color palette used"
              },
              "complexity": {
                "type": "string",
                "enum": ["simple", "moderate", "detailed"]
              },
              "elements_depicted": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Objects shown in illustration",
                "examples": ["knife", "cutting board", "vegetables"]
              }
            }
          },
          "generation_metadata": {
            "type": "object",
            "properties": {
              "gan_model": {
                "type": "string",
                "description": "Model version used"
              },
              "generation_seed": {
                "type": "integer",
                "description": "Seed used for reproducibility"
              },
              "generation_time_ms": {"type": "number"},
              "quality_score": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Automated quality assessment"
              },
              "used_template": {
                "type": "boolean",
                "description": "Whether template was used vs. generated"
              },
              "post_processing": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Applied enhancements",
                "examples": ["edge_cleanup", "line_smoothing"]
              },
              "timestamp": {"type": "string", "format": "date-time"}
            }
          },
          "alt_text": {
            "type": "string",
            "maxLength": 200,
            "description": "Accessibility description of illustration"
          }
        }
      },
      "quality_check": {
        "type": "object",
        "properties": {
          "passed": {"type": "boolean"},
          "quality_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "issues_detected": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Potential problems found",
            "examples": ["blank_image", "excessive_noise", "unclear_elements"]
          },
          "approval_status": {
            "type": "string",
            "enum": ["auto_approved", "needs_review", "rejected"]
          }
        }
      }
    }
  },

  "error_responses": [
    {
      "error_code": "GENERATION_FAILED",
      "description": "GAN failed to generate valid illustration",
      "http_status": 500,
      "fallback": "Use template illustration for cooking method"
    },
    {
      "error_code": "QUALITY_CHECK_FAILED",
      "description": "Generated illustration below quality threshold (< 0.6)",
      "http_status": 200,
      "action": "Retry generation or use template"
    },
    {
      "error_code": "UNKNOWN_COOKING_METHOD",
      "description": "Cooking method not in GAN training data",
      "http_status": 400,
      "fallback": "Use generic cooking illustration"
    },
    {
      "error_code": "INVALID_DIMENSIONS",
      "description": "Requested dimensions not supported",
      "http_status": 400
    }
  ],

  "performance_requirements": {
    "max_generation_time_ms": 300,
    "max_memory_mb": 1500,
    "min_quality_score": 0.6,
    "success_rate_target": "95% generate valid illustrations",
    "user_rating_target": "80% helpful for understanding step"
  },

  "template_library": {
    "description": "Pre-made illustrations for common cooking actions",
    "location": "data/raw/illustration_templates/",
    "coverage": [
      "chopping (knife on cutting board)",
      "sautéing (pan on stove)",
      "mixing (bowl with spoon)",
      "baking (oven with dish)",
      "serving (plate with food)"
    ],
    "usage": "Fallback when GAN generation fails or for speed optimization"
  },

  "quality_validation": {
    "automated_checks": [
      "Image not blank (pixel variance > threshold)",
      "Clear line definition (edge detection score)",
      "Appropriate complexity (element count within range)",
      "No artifacts (noise level check)"
    ],
    "quality_score_calculation": "Weighted average of automated checks",
    "approval_threshold": 0.6,
    "human_review_queue": "Illustrations with score 0.5-0.6 flagged for manual review"
  },

  "notebook_implementation": {
    "location": "notebooks/model_illustration_generation/model_gan_inference.ipynb",
    "workflow": [
      "Extract cooking action from step text",
      "Check template library for matching illustration",
      "If no template: generate via Pix2Pix GAN",
      "Apply post-processing (edge cleanup, line smoothing)",
      "Run quality validation",
      "If quality_score >= 0.6: approve",
      "If quality_score < 0.6: retry or use template",
      "Save as SVG for scalability",
      "Generate alt text for accessibility"
    ]
  },

  "optimization_strategies": {
    "caching": "Cache generated illustrations for reuse across recipes",
    "batch_generation": "Generate multiple illustrations in parallel on GPU",
    "lazy_loading": "Generate illustrations only when user selects recipe (not for all 5)",
    "template_first": "Use templates for speed, generate unique illustrations for complex steps"
  }
}
