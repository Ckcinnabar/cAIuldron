{
  "contract_name": "Recipe Generation API",
  "description": "Transformer-based recipe generation with diverse cuisine options and RNN refinement",
  "version": "1.0.0",
  "model_components": ["Transformer (GPT-2 Medium)", "RNN (BiLSTM)"],

  "input_schema": {
    "type": "object",
    "required": ["ingredient", "generation_params"],
    "properties": {
      "ingredient": {
        "type": "object",
        "description": "Identified ingredient from CNN",
        "properties": {
          "name": {"type": "string"},
          "category": {"type": "string"},
          "quantity_grams": {"type": "number"}
        },
        "required": ["name"]
      },
      "generation_params": {
        "type": "object",
        "properties": {
          "num_recipes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5,
            "description": "Number of recipes to generate"
          },
          "cuisine_types": {
            "type": "array",
            "description": "Requested cuisine diversity",
            "items": {
              "type": "string",
              "enum": ["Asian", "Western", "Mediterranean", "Latin", "Middle Eastern", "Fusion", "Any"]
            },
            "default": ["Asian", "Western", "Fusion", "Any", "Any"]
          },
          "difficulty_preference": {
            "type": "string",
            "enum": ["beginner", "intermediate", "advanced", "any"],
            "default": "any"
          },
          "max_cooking_time_minutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 480,
            "default": 120
          },
          "dietary_restrictions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["vegetarian", "vegan", "gluten-free", "dairy-free", "none"]
            },
            "default": ["none"]
          }
        }
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["recipes"],
    "properties": {
      "recipes": {
        "type": "array",
        "minItems": 5,
        "items": {
          "type": "object",
          "required": ["recipe_id", "title", "cuisine_type", "cooking_time_minutes", "difficulty_level", "ingredients_list", "cooking_steps"],
          "properties": {
            "recipe_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "maxLength": 100,
              "description": "Recipe name"
            },
            "cuisine_type": {
              "type": "string",
              "description": "Cuisine category"
            },
            "cooking_time_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 480,
              "description": "Total cooking time (RNN-refined)"
            },
            "difficulty_level": {
              "type": "string",
              "enum": ["beginner", "intermediate", "advanced"]
            },
            "serving_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "ingredients_list": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "quantity": {"type": "string"},
                  "unit": {"type": "string"},
                  "optional": {"type": "boolean", "default": false},
                  "substitutions": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Alternative ingredients"
                  }
                },
                "required": ["name", "quantity", "unit"]
              }
            },
            "cooking_steps": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "step_number": {"type": "integer", "minimum": 1},
                  "instruction_text": {"type": "string", "maxLength": 500},
                  "estimated_time_minutes": {"type": "integer", "minimum": 0},
                  "cooking_method": {
                    "type": "string",
                    "enum": ["chop", "dice", "slice", "sauté", "fry", "bake", "roast", "boil", "simmer", "grill", "steam", "mix", "marinate", "rest", "serve"]
                  },
                  "temperature": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "integer"},
                      "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}
                    }
                  },
                  "timing_alert": {
                    "type": "boolean",
                    "description": "Whether step needs timer notification"
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {"type": "integer"},
                    "description": "Prerequisite step numbers"
                  }
                },
                "required": ["step_number", "instruction_text", "cooking_method"]
              }
            },
            "ai_metadata": {
              "type": "object",
              "properties": {
                "transformer_model": {"type": "string"},
                "generation_timestamp": {"type": "string", "format": "date-time"},
                "rnn_refined": {"type": "boolean"},
                "generation_seed": {"type": "integer"},
                "temperature": {"type": "number"},
                "top_p": {"type": "number"}
              }
            }
          }
        }
      },
      "generation_summary": {
        "type": "object",
        "properties": {
          "total_recipes": {"type": "integer"},
          "cuisine_diversity": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Unique cuisines in results"
          },
          "difficulty_distribution": {
            "type": "object",
            "properties": {
              "beginner": {"type": "integer"},
              "intermediate": {"type": "integer"},
              "advanced": {"type": "integer"}
            }
          },
          "avg_cooking_time_minutes": {"type": "number"},
          "processing_time_ms": {"type": "number"}
        }
      }
    }
  },

  "error_responses": [
    {
      "error_code": "GENERATION_FAILED",
      "description": "Transformer model failed to generate valid recipes",
      "http_status": 500
    },
    {
      "error_code": "INVALID_INGREDIENT",
      "description": "Ingredient not recognized by recipe database",
      "http_status": 400
    },
    {
      "error_code": "RNN_REFINEMENT_FAILED",
      "description": "Step sequence refinement failed, using original Transformer output",
      "http_status": 200,
      "warning": "Recipes generated without RNN optimization"
    },
    {
      "error_code": "INSUFFICIENT_DIVERSITY",
      "description": "Could not generate requested cuisine diversity",
      "http_status": 200,
      "warning": "Some cuisines may be repeated"
    }
  ],

  "performance_requirements": {
    "max_generation_time_ms": 3000,
    "max_memory_mb": 3000,
    "min_cuisine_diversity": 3,
    "quality_target": "85% rated clear and followable"
  },

  "workflow": {
    "step_1": {
      "description": "Transformer generates 5 recipes in parallel",
      "notebook": "notebooks/model_recipe_generation/model_transformer_inference.ipynb",
      "input": "Ingredient + cuisine type prompts",
      "output": "Raw recipe text with steps"
    },
    "step_2": {
      "description": "RNN refines cooking times and step sequences",
      "notebook": "notebooks/model_cooking_refinement/model_rnn_inference.ipynb",
      "input": "Raw recipe steps",
      "output": "Optimized step order and timing"
    }
  }
}
