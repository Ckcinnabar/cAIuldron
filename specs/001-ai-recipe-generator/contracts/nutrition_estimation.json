{
  "contract_name": "Nutrition Estimation API",
  "description": "Probabilistic Graphical Model for calorie and portion size estimation",
  "version": "1.0.0",
  "model_component": "Bayesian Network (pgmpy)",

  "input_schema": {
    "type": "object",
    "required": ["recipe", "ingredient_quantity"],
    "properties": {
      "recipe": {
        "type": "object",
        "description": "Generated recipe for nutrition calculation",
        "properties": {
          "recipe_id": {"type": "string", "format": "uuid"},
          "ingredients_list": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "quantity": {"type": "string"},
                "unit": {"type": "string"}
              }
            }
          },
          "cooking_methods": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Methods used (affects calorie calculation for oils, etc.)"
          },
          "serving_count": {"type": "integer"}
        },
        "required": ["recipe_id", "ingredients_list", "serving_count"]
      },
      "ingredient_quantity": {
        "type": "object",
        "description": "Primary ingredient size from CNN",
        "properties": {
          "name": {"type": "string"},
          "weight_grams": {"type": "number"},
          "weight_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        },
        "required": ["name", "weight_grams"]
      },
      "nutritional_preferences": {
        "type": "object",
        "description": "Optional calculation parameters",
        "properties": {
          "include_macros": {"type": "boolean", "default": true},
          "confidence_level": {"type": "number", "default": 0.8, "description": "For confidence intervals"},
          "cooking_oil_assumption": {
            "type": "string",
            "enum": ["none", "light", "moderate", "heavy"],
            "default": "moderate"
          }
        }
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["portion_estimate"],
    "properties": {
      "portion_estimate": {
        "type": "object",
        "required": ["estimate_id", "servings", "calories_per_serving", "calorie_range"],
        "properties": {
          "estimate_id": {
            "type": "string",
            "format": "uuid"
          },
          "servings": {
            "type": "integer",
            "description": "Number of servings (from recipe)"
          },
          "portion_size_per_serving": {
            "type": "string",
            "description": "Human-readable portion size",
            "examples": ["200g", "1 cup", "1 piece"]
          },
          "total_weight_grams": {
            "type": "number",
            "description": "Total recipe weight including all ingredients"
          },
          "calories_per_serving": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000,
            "description": "Primary calorie estimate"
          },
          "calorie_range": {
            "type": "object",
            "required": ["min", "max", "confidence_level"],
            "properties": {
              "min": {
                "type": "number",
                "description": "Lower bound of confidence interval"
              },
              "max": {
                "type": "number",
                "description": "Upper bound of confidence interval"
              },
              "confidence_level": {
                "type": "number",
                "default": 0.8,
                "description": "Probability that true value is in range"
              }
            }
          },
          "macronutrients": {
            "type": "object",
            "description": "Detailed nutritional breakdown (if include_macros=true)",
            "properties": {
              "protein_grams": {"type": "number", "minimum": 0},
              "carbs_grams": {"type": "number", "minimum": 0},
              "fat_grams": {"type": "number", "minimum": 0},
              "fiber_grams": {"type": "number", "minimum": 0},
              "sodium_mg": {"type": "number", "minimum": 0}
            }
          },
          "estimation_metadata": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": ["bayesian_pgm", "usda_lookup", "hybrid"]
              },
              "data_sources": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Nutritional databases used",
                "examples": ["USDA FoodData Central", "Recipe1M+"]
              },
              "uncertainty_factors": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Known sources of variation",
                "examples": ["Cooking method variation", "Ingredient size estimation", "Oil absorption"]
              },
              "quality_score": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Confidence in overall estimate"
              },
              "timestamp": {"type": "string", "format": "date-time"}
            }
          }
        }
      },
      "ingredient_nutrition_breakdown": {
        "type": "array",
        "description": "Per-ingredient calorie contribution",
        "items": {
          "type": "object",
          "properties": {
            "ingredient_name": {"type": "string"},
            "calories": {"type": "number"},
            "percentage_of_total": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }
      }
    }
  },

  "error_responses": [
    {
      "error_code": "INGREDIENT_NOT_IN_DB",
      "description": "Ingredient not found in nutritional database",
      "http_status": 200,
      "fallback": "Use category average (e.g., 'fish' if 'salmon' missing)"
    },
    {
      "error_code": "UNREALISTIC_ESTIMATE",
      "description": "Calculated calories outside reasonable range",
      "http_status": 200,
      "action": "Flag for manual review, provide estimate with warning"
    },
    {
      "error_code": "PGM_INFERENCE_FAILED",
      "description": "Bayesian network inference error",
      "http_status": 500
    },
    {
      "error_code": "MISSING_SERVING_INFO",
      "description": "Recipe does not specify serving count",
      "http_status": 400
    }
  },

  "performance_requirements": {
    "max_inference_time_ms": 10,
    "max_memory_mb": 50,
    "accuracy_target": "±20% vs measured portions",
    "min_quality_score": 0.6
  },

  "validation_rules": {
    "calorie_range": "min ≤ calories_per_serving ≤ max",
    "calorie_bounds": "0 < calories_per_serving < 5000",
    "macro_sum": "protein×4 + carbs×4 + fat×9 ≈ calories (±15%)",
    "serving_match": "servings must equal recipe.serving_count",
    "confidence_interval": "confidence_level typically 0.8 (80%)"
  },

  "notebook_implementation": {
    "location": "notebooks/model_nutrition_estimation/model_pgm_inference.ipynb",
    "workflow": [
      "Load USDA nutritional database",
      "Query base calories for each ingredient",
      "Adjust for estimated quantity (from CNN)",
      "Factor in cooking method (oils, butter, etc.)",
      "Run Bayesian network inference",
      "Generate confidence intervals",
      "Output portion estimate with calorie range"
    ]
  },

  "nutritional_database": {
    "primary": "USDA FoodData Central",
    "version": "2024",
    "coverage": "8000+ common ingredients",
    "update_frequency": "Annual snapshot",
    "fallback_strategy": "Use category averages if specific ingredient missing"
  }
}
